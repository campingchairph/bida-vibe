rules_version = '2';
// Bida-Vibe — Firestore security rules.
// The rules are the lock: page code is never trusted.
// Publish: Firebase Console → Databases & Storage → Firestore → Rules → paste this whole file → Publish.
service cloud.firestore {
  match /databases/{database}/documents {

    // Admin = a real Google sign-in, Google-verified email, whose SHA-256 fingerprint matches.
    // (The email itself is not written here, so this public file doesn't reveal it.)
    function isBidaAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && hashing.sha256(request.auth.token.email.lower()).toHexString().lower()
           == '291b86481ed2c63b356ae7c2bf0649292169d535f061785fc88a829d26cb50bd';
    }

    // The GitHub token the admin page uses to upload sound pads (same idea as Morphii's morphii_secrets).
    // Only the admin can read or change it. Nobody else — not even signed-in users — can see it.
    match /bida_secrets/{docId} {
      allow read, write: if isBidaAdmin();
    }

    // Optional extra admins: document ID = Google email in lowercase. A verified user may read ONLY their own.
    match /admins/{email} {
      allow get: if request.auth != null
                 && request.auth.token.email_verified == true
                 && request.auth.token.email.lower() == email;
      allow list, write: if false;
    }

    // A singer's selfie: optional, a small camera JPEG only (about 8 KB, never over 16,000 characters)
    function okPhoto(d) {
      return !('ph' in d) || (d.ph is string && d.ph.size() <= 16000 && d.ph.matches('^data:image/jpeg;base64,[A-Za-z0-9+/]+=*$'));
    }

    // The mouth style picked on the camera screen (optional, a short id)
    function okMouth(d) { return !('mo' in d) || (d.mo is string && d.mo.matches('^[a-z]{1,10}$')); }

    // Videoke rooms: one per host + event, opened from the host's signed-in app.
    // Anyone with the (long, random) link can READ the room to see the queue; only the host can change it.
    function roomFields() { return ['owner', 'title', 'open', 'expires', 'queue', 'now', 'updated']; }
    match /vk_rooms/{room} {
      // Guests can only read a room while it's open and not expired; afterwards only the host can.
      allow get: if room.matches('^[A-Za-z0-9]{24}$')
        && ((resource.data.open == true && resource.data.expires > request.time)
            || (request.auth != null && resource.data.owner == request.auth.uid));
      allow list: if false;
      allow create: if request.auth != null
        && room.matches('^[A-Za-z0-9]{24}$')
        && request.resource.data.keys().hasOnly(roomFields())
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.title is string && request.resource.data.title.size() <= 90
        && request.resource.data.open is bool
        && request.resource.data.expires is timestamp
        && request.resource.data.expires < request.time + duration.value(3, 'd')
        && request.resource.data.queue is list && request.resource.data.queue.size() <= 40;
      allow update: if request.auth != null
        && resource.data.owner == request.auth.uid
        && request.resource.data.owner == resource.data.owner
        && request.resource.data.keys().hasOnly(roomFields())
        && request.resource.data.title is string && request.resource.data.title.size() <= 90
        && request.resource.data.expires == resource.data.expires
        && request.resource.data.queue is list && request.resource.data.queue.size() <= 40;
      allow delete: if request.auth != null && resource.data.owner == request.auth.uid;

      // A guest's song request. Guests don't sign in; they can only ADD a well-formed request
      // to an open, unexpired room. Only the host can read (pick up) and delete them.
      match /requests/{req} {
        function rm() { return get(/databases/$(database)/documents/vk_rooms/$(room)).data; }
        allow create: if rm().open == true
          && rm().expires > request.time
          && request.resource.data.keys().hasOnly(['name', 'av', 'c', 't', 'a', 'y', 'ph', 'mo', 'at'])
          && okPhoto(request.resource.data) && okMouth(request.resource.data)
          && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 24
          && request.resource.data.av is string && request.resource.data.av.matches('^[a-z]{2,10}$')
          && request.resource.data.c is int && request.resource.data.c >= 1 && request.resource.data.c <= 99999
          && request.resource.data.t is string && request.resource.data.t.size() <= 80
          && request.resource.data.a is string && request.resource.data.a.size() <= 60
          && request.resource.data.y is string && request.resource.data.y.matches('^[A-Za-z0-9_-]{11}$')
          && request.resource.data.at == request.time;
        allow read, delete: if request.auth != null && rm().owner == request.auth.uid;
        allow update: if false;
      }
    }

    // Host remote: the TV app (signed-in host) keeps a snapshot here; a co-host's phone opens
    // remote.html with the long random id. Only the owner can change the doc.
    // PIN: the host sets a 6-digit PIN (lock/pin, which nobody can read). A phone signs in anonymously and
    // must create devices/{its uid} with the right PIN. Only connected phones can read the remote or send
    // commands; the host sees every connected phone and can remove it.
    match /vk_remotes/{rid} {
      function remoteDoc() { return get(/databases/$(database)/documents/vk_remotes/$(rid)).data; }
      function isOwner() { return request.auth != null && remoteDoc().owner == request.auth.uid; }
      function isLive() { return remoteDoc().open == true && remoteDoc().expires > request.time; }
      function isDevice() { return request.auth != null && exists(/databases/$(database)/documents/vk_remotes/$(rid)/devices/$(request.auth.uid)); }
      // A connected phone can read it only while it's open and not expired; the host always can
      allow get: if rid.matches('^[A-Za-z0-9]{24}$')
        && ((resource.data.open == true && resource.data.expires > request.time && isDevice())
            || (request.auth != null && resource.data.owner == request.auth.uid));
      allow list: if false;
      allow create: if request.auth != null
        && rid.matches('^[A-Za-z0-9]{24}$')
        && request.resource.data.keys().hasOnly(['owner', 'open', 'expires', 'state', 'updated'])
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.open is bool
        && request.resource.data.expires is timestamp
        && request.resource.data.expires < request.time + duration.value(2, 'd')
        && request.resource.data.state is map;
      allow update: if request.auth != null
        && resource.data.owner == request.auth.uid
        && request.resource.data.owner == resource.data.owner
        && request.resource.data.keys().hasOnly(['owner', 'open', 'expires', 'state', 'updated'])
        && request.resource.data.expires == resource.data.expires
        && request.resource.data.state is map;
      allow delete: if request.auth != null && resource.data.owner == request.auth.uid;

      // The PIN. Only the host can set it; NOBODY can read it (the rules below compare against it).
      match /lock/{doc} {
        allow read: if false;
        allow create, update: if doc == 'pin' && isOwner()
          && request.resource.data.keys().hasOnly(['pin'])
          && request.resource.data.pin is string && request.resource.data.pin.matches('^[0-9]{6}$');
        allow delete: if isOwner();
      }

      // A connected phone (document ID = that phone's anonymous sign-in). Created only with the right PIN.
      match /devices/{uid} {
        allow create: if request.auth != null && request.auth.uid == uid && isLive()
          && request.resource.data.keys().hasOnly(['name', 'ua', 'pin', 'at'])
          && request.resource.data.pin == get(/databases/$(database)/documents/vk_remotes/$(rid)/lock/pin).data.pin
          && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 24
          && request.resource.data.ua is string && request.resource.data.ua.size() <= 40
          && request.resource.data.at == request.time;
        allow read, delete: if isOwner();                    // the host's "connected" list and the Remove button
        allow update: if false;
      }

      // A command from the phone (play a pad, skip a song…). It can only be ADDED, only while the
      // remote is open, and only in this small shape. The TV reads it, checks it, runs it, deletes it.
      match /cmds/{cmd} {
        function rr() { return get(/databases/$(database)/documents/vk_remotes/$(rid)).data; }
        allow create: if rr().open == true
          && rr().expires > request.time
          && isDevice()
          && request.resource.data.keys().hasOnly(['k', 'v', 'n', 's', 'av', 'ph', 'mo', 'at'])
          && request.resource.data.k in ['pad', 'stop', 'music', 'plan', 'vk', 'score', 'show']
          && okPhoto(request.resource.data) && okMouth(request.resource.data)
          && request.resource.data.v is string && request.resource.data.v.size() <= 40
          && request.resource.data.n is int && request.resource.data.n >= -1 && request.resource.data.n <= 999999
          && request.resource.data.s is string && request.resource.data.s.size() <= 24
          && request.resource.data.av is string && request.resource.data.av.size() <= 10
          && request.resource.data.at == request.time;
        allow read, delete: if request.auth != null && rr().owner == request.auth.uid;
        allow update: if false;
      }
    }

    // ---------- 3-day free Premium (referral trial) ----------
    // 1 NEW friend signs in with your link = 3 days Premium for you and for them. Once per Gmail, ever.
    function isGoogle() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.firebase.sign_in_provider == 'google.com';
    }
    function joinedPath(u) { return /databases/$(database)/documents/bv_users/$(u); }

    // The one-time "joined" record, written at an account's FIRST sign-in. ref = who invited it ('' = nobody).
    // It can never be changed or deleted, so an existing user can't be "invited" later and invites can't be swapped.
    match /bv_users/{uid} {
      allow get: if (request.auth != null && request.auth.uid == uid) || isBidaAdmin();
      // the admin sees everyone; a user can list ONLY the friends who joined with their link
      allow list: if isBidaAdmin() || (request.auth != null && resource.data.ref == request.auth.uid);
      allow create: if isGoogle() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['at', 'ref', 'dev'])
        && request.resource.data.at == request.time
        && request.resource.data.dev is string && request.resource.data.dev.matches('^[A-Za-z0-9]{8,32}$')
        && request.resource.data.ref is string
        && (request.resource.data.ref == ''
            || (request.resource.data.ref != uid && exists(joinedPath(request.resource.data.ref))));
      allow update, delete: if false;
    }

    // Who the account is, for the admin's Referrals page only (nobody else can read it)
    match /bv_who/{uid} {
      allow create: if isGoogle() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['em', 'nm', 'ua', 'at', 'exp'])
        && request.resource.data.em == request.auth.token.email
        && request.resource.data.nm is string && request.resource.data.nm.size() <= 40
        && request.resource.data.ua is string && request.resource.data.ua.size() <= 20
        && request.resource.data.at == request.time
        // deleted automatically by a Firestore TTL policy on 'exp' (about 93 days later)
        && request.resource.data.exp is timestamp
        && request.resource.data.exp > request.time + duration.value(90, 'd')
        && request.resource.data.exp < request.time + duration.value(96, 'd');
      allow read: if isBidaAdmin();
      allow update, delete: if false;
    }

    // The trial: created ONCE per account, never edited or deleted by the user. start = server time;
    // the app ends it at start + 3 days (server time). Allowed only if the friend's joined record names
    // this account as the inviter, or this account's joined record names the friend.
    match /bv_trials/{uid} {
      allow get: if (request.auth != null && request.auth.uid == uid) || isBidaAdmin();
      allow list: if isBidaAdmin();
      allow create: if isGoogle() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['start', 'via', 'revoked'])
        && request.resource.data.start == request.time
        && request.resource.data.revoked == false
        && request.resource.data.via is string && request.resource.data.via != uid
        && request.resource.data.via.matches('^[A-Za-z0-9]{10,128}$')
        && exists(joinedPath(uid))
        && (get(joinedPath(request.resource.data.via)).data.ref == uid
            || get(joinedPath(uid)).data.ref == request.resource.data.via);
      // Only the admin can end a trial early (Revoke). It can never be restarted.
      allow update: if isBidaAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['revoked', 'revokedAt'])
        && request.resource.data.revoked == true
        && request.resource.data.revokedAt == request.time;
      allow delete: if false;
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
