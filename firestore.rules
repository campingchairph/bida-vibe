rules_version = '2';
// Bida-Vibe — Firestore security rules.
// The rules are the lock: page code is never trusted.
// Publish: Firebase Console → Databases & Storage → Firestore → Rules → paste this whole file → Publish.
service cloud.firestore {
  match /databases/{database}/documents {

    // Admin = a real Google sign-in, Google-verified email, whose SHA-256 fingerprint matches.
    // (The email itself is not written here, so this public file doesn't reveal it.)
    function isBidaAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && hashing.sha256(request.auth.token.email.lower()).toHexString().lower()
           == '291b86481ed2c63b356ae7c2bf0649292169d535f061785fc88a829d26cb50bd';
    }

    // The GitHub token the admin page uses to upload sound pads (same idea as Morphii's morphii_secrets).
    // Only the admin can read or change it. Nobody else — not even signed-in users — can see it.
    match /bida_secrets/{docId} {
      allow read, write: if isBidaAdmin();
    }

    // Optional extra admins: document ID = Google email in lowercase. A verified user may read ONLY their own.
    match /admins/{email} {
      allow get: if request.auth != null
                 && request.auth.token.email_verified == true
                 && request.auth.token.email.lower() == email;
      allow list, write: if false;
    }

    // A singer's selfie: optional, a small camera JPEG only (about 8 KB, never over 16,000 characters)
    function okPhoto(d) {
      return !('ph' in d) || (d.ph is string && d.ph.size() <= 16000 && d.ph.matches('^data:image/jpeg;base64,[A-Za-z0-9+/]+=*$'));
    }

    // Videoke rooms: one per host + event, opened from the host's signed-in app.
    // Anyone with the (long, random) link can READ the room to see the queue; only the host can change it.
    function roomFields() { return ['owner', 'title', 'open', 'expires', 'queue', 'now', 'updated']; }
    match /vk_rooms/{room} {
      allow get: if room.matches('^[A-Za-z0-9]{24}$');
      allow list: if false;
      allow create: if request.auth != null
        && room.matches('^[A-Za-z0-9]{24}$')
        && request.resource.data.keys().hasOnly(roomFields())
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.title is string && request.resource.data.title.size() <= 90
        && request.resource.data.open is bool
        && request.resource.data.expires is timestamp
        && request.resource.data.expires < request.time + duration.value(3, 'd')
        && request.resource.data.queue is list && request.resource.data.queue.size() <= 40;
      allow update: if request.auth != null
        && resource.data.owner == request.auth.uid
        && request.resource.data.owner == resource.data.owner
        && request.resource.data.keys().hasOnly(roomFields())
        && request.resource.data.title is string && request.resource.data.title.size() <= 90
        && request.resource.data.expires == resource.data.expires
        && request.resource.data.queue is list && request.resource.data.queue.size() <= 40;
      allow delete: if request.auth != null && resource.data.owner == request.auth.uid;

      // A guest's song request. Guests don't sign in; they can only ADD a well-formed request
      // to an open, unexpired room. Only the host can read (pick up) and delete them.
      match /requests/{req} {
        function rm() { return get(/databases/$(database)/documents/vk_rooms/$(room)).data; }
        allow create: if rm().open == true
          && rm().expires > request.time
          && request.resource.data.keys().hasOnly(['name', 'av', 'c', 't', 'a', 'y', 'ph', 'at'])
          && okPhoto(request.resource.data)
          && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 24
          && request.resource.data.av is string && request.resource.data.av.matches('^[a-z]{2,10}$')
          && request.resource.data.c is int && request.resource.data.c >= 1 && request.resource.data.c <= 99999
          && request.resource.data.t is string && request.resource.data.t.size() <= 80
          && request.resource.data.a is string && request.resource.data.a.size() <= 60
          && request.resource.data.y is string && request.resource.data.y.matches('^[A-Za-z0-9_-]{11}$')
          && request.resource.data.at == request.time;
        allow read, delete: if request.auth != null && rm().owner == request.auth.uid;
        allow update: if false;
      }
    }

    // Host remote: the TV app (signed-in host) keeps a snapshot here; the host's phone opens
    // remote.html with the long random id. Only the owner can change the doc.
    match /vk_remotes/{rid} {
      allow get: if rid.matches('^[A-Za-z0-9]{24}$');
      allow list: if false;
      allow create: if request.auth != null
        && rid.matches('^[A-Za-z0-9]{24}$')
        && request.resource.data.keys().hasOnly(['owner', 'open', 'expires', 'state', 'updated'])
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.open is bool
        && request.resource.data.expires is timestamp
        && request.resource.data.expires < request.time + duration.value(2, 'd')
        && request.resource.data.state is map;
      allow update: if request.auth != null
        && resource.data.owner == request.auth.uid
        && request.resource.data.owner == resource.data.owner
        && request.resource.data.keys().hasOnly(['owner', 'open', 'expires', 'state', 'updated'])
        && request.resource.data.expires == resource.data.expires
        && request.resource.data.state is map;
      allow delete: if request.auth != null && resource.data.owner == request.auth.uid;

      // A command from the phone (play a pad, skip a song…). It can only be ADDED, only while the
      // remote is open, and only in this small shape. The TV reads it, checks it, runs it, deletes it.
      match /cmds/{cmd} {
        function rr() { return get(/databases/$(database)/documents/vk_remotes/$(rid)).data; }
        allow create: if rr().open == true
          && rr().expires > request.time
          && request.resource.data.keys().hasOnly(['k', 'v', 'n', 's', 'av', 'ph', 'at'])
          && request.resource.data.k in ['pad', 'stop', 'music', 'plan', 'vk', 'score']
          && okPhoto(request.resource.data)
          && request.resource.data.v is string && request.resource.data.v.size() <= 40
          && request.resource.data.n is int && request.resource.data.n >= -1 && request.resource.data.n <= 999999
          && request.resource.data.s is string && request.resource.data.s.size() <= 24
          && request.resource.data.av is string && request.resource.data.av.size() <= 10
          && request.resource.data.at == request.time;
        allow read, delete: if request.auth != null && rr().owner == request.auth.uid;
        allow update: if false;
      }
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
